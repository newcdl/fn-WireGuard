#!/bin/bash
# 应用运行控制。
# 约定：start 成功返回 0 / 失败返回 1；status 运行中返回 0 / 未运行返回 3。

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common
. "$DIR/common"

case "$1" in
start)
    fnwg_ensure_group
    fnwg_prepare_dirs
    if ! fnwg_start; then
        fnwg_fail "启动失败（方式: $(fnwg_mode)）。systemd 方式请执行 journalctl -u ${FNWG_UNIT_AGENT} -u ${FNWG_UNIT_WEB}；PID 方式请查看 ${TRIM_PKGVAR}/log/"
    fi
    # 端口与网关入口都要确认。只等端口是不够的：应用已在运行（或 systemd 已经把
    # 单元拉起来）时，`systemctl start` 是空操作，Web 进程不会重启，socket 也不会重建 ——
    # 这时若只查端口就会报告「启动成功」，而飞牛桌面点图标仍然是 502。
    # fnwg_ensure_gateway_ready 会同时确认两者，并在入口没起来时自动修一次再判。
    if ! fnwg_ensure_gateway_ready 15; then
        fnwg_fail "Web 服务或飞牛统一网关入口在 15 秒内未就绪（从飞牛桌面打开会显示 502）。
       请检查 ${TRIM_PKGVAR}/log/web.log，或执行 journalctl -u ${FNWG_UNIT_WEB} 查看原因"
    fi
    exit 0
    ;;
stop)
    fnwg_stop
    exit 0
    ;;
status)
    if fnwg_status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
