# 安装前置检查：架构、内核模块、端口占用、已有配置探测。
# 注意：内核态 WireGuard 不依赖 /dev/net/tun，因此缺少 TUN 只提示不阻断。
set -e

[ -n "$TRIM_TEMP_LOGFILE" ] || TRIM_TEMP_LOGFILE=/tmp/fn-wireguard-install.log
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common
. "$DIR/common"

fnwg_log "开始安装前环境检查"

arch="$(uname -m)"
case "$arch" in
    x86_64 | aarch64 | arm64) ;;
    *) fnwg_fail "不支持的系统架构：${arch}" ;;
esac

# 数据面可用性：内核模块优先（标准模式）；缺失时只要有 /dev/net/tun，
# 应用会自动改用用户态实现（兼容模式），功能相同、速度略低，因此不算致命。
if modprobe wireguard >/dev/null 2>&1 || [ -e /sys/module/wireguard ]; then
    fnwg_log "内核 wireguard 模块可用，将使用标准模式"
elif [ -e /dev/net/tun ]; then
    fnwg_log "未检测到内核 wireguard 模块，将自动使用兼容模式（用户态实现），功能不受影响"
else
    fnwg_log "警告：内核 wireguard 模块与 /dev/net/tun 都不可用，新建的连接将无法工作。" \
        "请确认系统内核版本（建议 5.6 以上），或在系统中启用 TUN/TAP 后重试。"
fi

port="$(fnwg_service_port)"
if command -v ss >/dev/null 2>&1; then
    if ss -ltn 2>/dev/null | awk '{print $4}' | grep -q ":${port}\$"; then
        fnwg_fail "管理端口 ${port} 已被占用，请先释放该端口（例如停用占用它的应用）后重新安装。"
    fi
fi

if [ -d /etc/wireguard ] && ls /etc/wireguard/*.conf >/dev/null 2>&1; then
    fnwg_log "检测到已有的 /etc/wireguard 配置，安装完成后可在「我的连接 → 导入配置」中一键导入"
fi

fnwg_log "环境检查通过（进程管理方式：$(fnwg_mode)）"
exit 0
